{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Changelog URL for Cloudflared",
      matchDatasources: ["docker"],
      matchPackageNames: ["cloudflare/cloudflared"],
      changelogUrl: "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES",
    },
    {
      description: "Changelog URL for 1Password Connect",
      matchPackageNames: ["/1password/"],
      changelogUrl: "https://github.com/1Password/connect/blob/main/CHANGELOG.md",
    },
    {
      description: "Changelog URL for ActualBudget",
      matchPackageNames: ["/actualbudget/"],
      changelogUrl: "https://www.actualbudget.com/blog/tags/release",
      sourceUrl: "https://github.com/actualbudget/actual",
    },
    {
      description: "Changelog URL for Plex",
      matchPackageNames: ["ghcr.io/home-operations/plex"],
      changelogUrl: "https://forums.plex.tv/t/plex-media-server/30447/last",
    },
    {
      description: "Changelog URL for VictoriaMetrics Logs",
      matchPackageNames: ["/victoria-logs-single/"],
      changelogUrl: "https://github.com/VictoriaMetrics/helm-charts/blob/master/charts/victoria-logs-single/CHANGELOG.md",
      sourceUrl: "https://github.com/VictoriaMetrics/helm-charts",
    },
    {
      description: "Changelog URL for envoy-proxy-crowdsec-bouncer",
      matchPackageNames: ["/kdwils/"],
      changelogUrl: "https://github.com/kdwils/envoy-proxy-crowdsec-bouncer/releases",
      sourceUrl: "https://github.com/kdwils/envoy-proxy-crowdsec-bouncer",
    },
    {
      description: "Changelog URL for SuggestArr",
      matchPackageNames: ["/suggestarr/"],
      changelogUrl: "https://github.com/giuseppe99barchetta/SuggestArr",
      sourceUrl: "https://github.com/giuseppe99barchetta/SuggestArr",
    },
  ],
}
